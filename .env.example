# Registry endpoint. For a local Docker registry, keep the default in compose.
REGISTRY_URL=https://registry.example.com
REGISTRY_VERIFY_TLS=true
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
ARGOCD_NAMESPACE=argocd
PROMETHEUS_URL=http://prometheus-server.monitoring.svc:9090
PROMETHEUS_VERIFY_TLS=true
# PROMETHEUS_BEARER_TOKEN=
SECRET_KEY=replace-with-a-random-long-value
